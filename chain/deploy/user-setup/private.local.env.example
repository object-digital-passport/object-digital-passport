# Скопируйте этот файл как private.local.env (рядом, в этой же папке) и заполните.
# НЕ вставляйте ключ в .example — только в private.local.env (он не в git).
# Файл private.local.env в git не попадает — см. корневой .gitignore.

# Обязательно для деплоя: приватный ключ кошелька БЕЗ префикса 0x (64 hex-символа).
PRIVATE_KEY=

# Опционально: верификация на Polygonscan.
# POLYGONSCAN_API_KEY=

# RPC: используйте ODP_POLYGON_RPC_URL / ODP_AMOY_RPC_URL (см. README).
# Так Hardhat не подхватит чужой POLYGON_RPC_URL из профиля shell с отключённым Alchemy.
