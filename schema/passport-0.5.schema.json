{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://object-digital-passport.github.io/schema/passport-0.5.schema.json",
  "title": "Object Digital Passport — passport.json v0.5",
  "description": "Machine-readable schema for the canonical v0.5 passport.json (SPEC.md §9). The minified, NFC-normalized, key-sorted bytes of this document anchor the on-chain dataHash. Additional properties are allowed: SPEC permits optional namespaces (identifiers, iiif, sustainability, compliance) and additionalMetadata.",
  "type": "object",
  "required": [
    "version",
    "passportId",
    "title",
    "authorship",
    "domain",
    "objectType",
    "status",
    "contentClass",
    "aiStatus",
    "verificationMethod",
    "edition",
    "year",
    "month",
    "registeredAt",
    "registration"
  ],
  "properties": {
    "version": {
      "const": "0.5",
      "description": "Document schema line. MUST be \"0.5\" for this schema."
    },
    "passportId": {
      "type": "string",
      "pattern": "^ODP-[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{9}$",
      "description": "On-chain Passport ID. YYYY-MM segments are the UTC mint month (SPEC §2)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "creationDate": {
      "type": "string",
      "minLength": 4,
      "description": "Object creation date or period anchor (ISO-like recommended). Not the mint date."
    },
    "objectYear": {
      "type": "integer",
      "description": "Historical object year when it differs from the UTC mint year (SPEC §9)."
    },
    "authorship": {
      "type": "object",
      "required": ["author"],
      "properties": {
        "author": { "$ref": "#/$defs/person" },
        "coAuthors": {
          "type": "array",
          "items": { "$ref": "#/$defs/person" }
        },
        "team": { "type": "string" }
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Area / field, e.g. contemporary_art, graphic_design, software."
    },
    "objectType": {
      "enum": ["physical", "digital", "mixed"]
    },
    "status": {
      "enum": ["concept", "prototype", "produced_object", "archived"],
      "description": "Lifecycle state mirrored to on-chain lifecycleStatus. On-chain value is authoritative after mint."
    },
    "contentClass": {
      "enum": ["static", "time_based", "spatial", "textual", "composite", "executable"]
    },
    "aiStatus": {
      "enum": ["none", "assisted", "generated"]
    },
    "verificationMethod": {
      "enum": ["self_asserted", "institutional", "nfc", "c2pa", "hybrid"]
    },
    "edition": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "enum": ["unique", "limited", "open", "dynamic"] },
        "number": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1970,
      "description": "UTC mint year. MUST match on-chain mint inputs."
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "UTC mint month. MUST match on-chain mint inputs."
    },
    "registeredAt": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix seconds (UTC instant) at registration."
    },
    "registration": {
      "type": "object",
      "required": ["utcIso8601", "localIso8601", "ianaTimeZone"],
      "properties": {
        "utcIso8601": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "localIso8601": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$",
          "description": "Legacy name: value MUST still encode the same UTC instant with +00:00 offset only."
        },
        "ianaTimeZone": {
          "const": "UTC",
          "description": "Always UTC in reference privacy mode; device-local zones MUST NOT be recorded."
        }
      }
    },
    "currentState": {
      "type": "object",
      "description": "Mutable-state snapshot at mint time. On-chain current-state fields are authoritative after mint. PRIVACY: precise storage locations on a public chain are readable by anyone forever — prefer coarse category values.",
      "properties": {
        "location": { "type": "string" },
        "rightsNote": { "type": "string" },
        "conditionNote": { "type": "string" },
        "damageHistoryHash": { "$ref": "#/$defs/sha256Prefixed" },
        "damageHistoryUrl": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "refinementTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "image": { "$ref": "#/$defs/imageRef" },
    "images": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/imageRef" },
      "description": "Additional preview images aligned with on-chain imageHash2 / imageHash3 (max 3 on-chain hashes total)."
    },
    "physical": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "medium": { "type": "string" },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "depth": { "type": "number" },
            "unit": { "type": "string" }
          }
        },
        "weight": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string" }
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "seal": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "nfc": {
              "type": "object",
              "required": ["uid", "publicKey", "model", "installedAt"],
              "properties": {
                "uid": { "type": "string", "pattern": "^[0-9a-f]{14}$" },
                "publicKey": { "type": "string", "pattern": "^[0-9a-fA-F]+$" },
                "model": { "enum": ["NTAG424DNA", "NTAG424DNA_TAGTAMPER"] },
                "installedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
                "notes": { "type": "string" }
              }
            },
            "numbered": {
              "type": "object",
              "required": ["number", "type"],
              "properties": {
                "number": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "color": { "type": "string" },
                "size": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "digital": {
      "type": "object",
      "properties": {
        "subtype": { "type": "string" },
        "format": { "type": "string" },
        "fileHash": { "$ref": "#/$defs/sha256Prefixed" },
        "fileSize": { "type": "integer", "minimum": 0 },
        "c2pa": {
          "type": "object",
          "properties": {
            "manifestHash": { "$ref": "#/$defs/sha256Prefixed" },
            "activeManifest": { "type": "string" }
          }
        }
      }
    },
    "objectId": {
      "type": "object",
      "description": "Optional Object ID compatibility block (docs/OBJECTID_PROFILE.md). Together with title, authorship, creationDate, physical.* and image it covers the nine Object ID checklist categories for theft documentation and recovery. Object ID is a standard of ICOM; this block is compatible with its checklist, not affiliated with or endorsed by ICOM.",
      "required": ["subject", "distinguishingFeatures"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "Object ID category 'Subject': what is depicted or represented (e.g. 'landscape with windmill', 'portrait of a woman')."
        },
        "distinguishingFeatures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Object ID category 'Distinguishing features': damage, repairs, manufacturing defects, irregularities that uniquely identify this object. Key both for theft recovery and for physical authenticity comparison against copies."
        }
      }
    },
    "additionalMetadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "objectType": { "enum": ["physical", "mixed"] } } },
      "then": { "required": ["physical"] }
    },
    {
      "if": { "properties": { "objectType": { "enum": ["digital", "mixed"] } } },
      "then": {
        "required": ["digital"],
        "properties": {
          "digital": { "type": "object", "required": ["fileHash"] }
        }
      }
    },
    {
      "if": { "properties": { "objectType": { "const": "physical" } } },
      "then": {
        "properties": {
          "physical": { "type": "object", "required": ["seal"] }
        }
      }
    },
    {
      "if": {
        "required": ["objectId"],
        "properties": { "objectType": { "enum": ["physical", "mixed"] } }
      },
      "then": {
        "required": ["image", "description", "creationDate"],
        "description": "Object ID profile: photograph (image), written description, and date/period are mandatory for physical objects."
      }
    }
  ],
  "$defs": {
    "person": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "wallet": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "description": "Full 42-char wallet address. Truncated display forms are not valid here."
        },
        "creatorId": {
          "type": "string",
          "pattern": "^[CBPM]-[0-9]{3}-[0-9]{3}-[0-9]{3}-[0-9]{3}$"
        }
      }
    },
    "sha256Prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 512
    },
    "imageRef": {
      "type": "object",
      "required": ["hash"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "hash": { "$ref": "#/$defs/sha256Prefixed" }
      }
    }
  }
}
